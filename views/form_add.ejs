<h1>Tambah Buku</h1>
<form action="/books" method="post">
  <div style="display: flex; flex-direction: column; gap: 2px">
    <label>Nama: <input name="name" required /></label><br />
    <label>Kategori: <input name="category" required /></label><br />
    <label
      >Harga: <input name="price" type="number" step="0.01" required /></label
    ><br />
    <label>Penerbit: <input name="publisher" /></label><br />
    <label
      >Image URL: <input name="image_url" placeholder="https://..." /></label
    ><br />
  </div>
  <button type="submit">Tambah</button>
</form>
